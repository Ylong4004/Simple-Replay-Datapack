tellraw @s [{text:"回放数据包命令：",color:"gold"}]
tellraw @s [{text:"/function replay:record/start",color:"green"},{text:" - 发放录制控制物品到快捷栏第 7-9 格",color:"gray"}]
tellraw @s [{text:"/function replay:record/stop",color:"yellow"},{text:" - 结束录制并打开保存对话框",color:"gray"}]
tellraw @s [{text:"/function replay:settings/open",color:"green"},{text:" - 打开回放设置对话框",color:"gray"}]
tellraw @s [{text:"/function replay:settings/show",color:"green"},{text:" - 显示当前回放设置",color:"gray"}]
tellraw @s [{text:"/function replay:library/list",color:"green"},{text:" - 查看已保存回放，并显示可点击操作",color:"gray"}]
tellraw @s [{text:"/function replay:library/delete {name:\"Replay\"}",color:"red"},{text:" - 删除指定名称的回放",color:"gray"}]
tellraw @s [{text:"/function replay:play/start {name:\"Replay\"}",color:"green"},{text:" - 用保存时的默认演员实体播放指定回放",color:"gray"}]
tellraw @s [{text:"/function replay:play/start_profile {name:\"Replay\",loop_playback:0b,on_finish_function:\"\",entity:{entity_type:\"minecraft:mannequin\",profile_name:\"PlayerName\",custom_name:\"Replay\",custom_name_visible:1b,hide_description:1b}}",color:"green"},{text:" - 使用自定义演员实体数据和播放选项播放",color:"gray"}]
tellraw @s [{text:"/function replay:play/start_profile {name:\"Replay\",loop_playback:0b,on_finish_function:\"replay:event/my_finish\",entity:{entity_type:\"minecraft:zombie\",custom_name:\"Replay\",NoAI:1b}}",color:"green"},{text:" - 使用其他实体类型并设置结束回调",color:"gray"}]
tellraw @s [{text:"start_profile 提示",color:"yellow"},{text:" - loop_playback 和 on_finish_function 是顶层播放选项；entity 里放 entity_type、profile_name、custom_name、description 等演员数据",color:"gray"}]
tellraw @s [{text:"回放控制物品",color:"yellow"},{text:" - 玩家启动回放时会获得暂停/继续和结束物品；准心附近对着演员右键即可控制",color:"gray"}]
tellraw @s [{text:"execute as <entity> at @s run function replay:play/start {name:\"Replay\"}",color:"aqua"},{text:" - 让指定实体作为演员播放回放",color:"gray"}]
tellraw @s [{text:"/function replay:play/stop_nearest",color:"yellow"},{text:" - 停止最近的活动回放演员",color:"gray"}]
tellraw @s [{text:"/function replay:play/stop_named {name:\"Replay\"}",color:"yellow"},{text:" - 按回放名称停止一个活动演员",color:"gray"}]
tellraw @s [{text:"/function replay:play/stop",color:"yellow"},{text:" - 停止全部回放，但保留演员实体",color:"gray"}]
tellraw @s [{text:"/function replay:play/kill_actor",color:"red"},{text:" - 清除由回放生成的演员实体",color:"gray"}]
