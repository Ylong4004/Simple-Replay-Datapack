tellraw @s [{text:"回放数据包命令：",color:"gold"}]
tellraw @s [{text:"单人录制",color:"yellow"}]
tellraw @s [{text:"/function replay:record/start",color:"green"},{text:" - 发放单人录制控制物品到快捷栏第 7-9 格。",color:"gray"}]
tellraw @s [{text:"/function replay:record/stop",color:"yellow"},{text:" - 结束单人录制并打开保存对话框。",color:"gray"}]
tellraw @s [{text:"动作挥手",color:"yellow"},{text:" - 方块交互、放置方块、攻击实体或玩家会记录为挥手；不会记录或回放方块变化本身。",color:"gray"}]
tellraw @s [{text:"多人连携录制",color:"yellow"}]
tellraw @s [{text:"/function replay:multi/create",color:"green"},{text:" - 创建连携录制，执行者成为主持人。",color:"gray"}]
tellraw @s [{text:"/function replay:multi/join",color:"green"},{text:" - 加入当前连携录制；第一版最多 8 人。",color:"gray"}]
tellraw @s [{text:"主持人右键热栏第 7 格开始/暂停/继续，右键第 8 格结束；所有成员第 9 格是挥手标记。",color:"gray"}]
tellraw @s [{text:"回放库",color:"yellow"}]
tellraw @s [{text:"/function replay:library/list",color:"green"},{text:" - 查看已保存录像，并显示可点击的播放、编辑、成员、覆盖、循环、删除。",color:"gray"}]
tellraw @s [{text:"/function replay:library/members {name:\"Replay\"}",color:"green"},{text:" - 列出多人录像的成员演员，并提供单成员演员编辑按钮。",color:"gray"}]
tellraw @s [{text:"/function replay:library/delete {name:\"Replay\"}",color:"red"},{text:" - 删除指定名称的录像。",color:"gray"}]
tellraw @s [{text:"播放",color:"yellow"}]
tellraw @s [{text:"/function replay:play/start {name:\"Replay\"}",color:"green"},{text:" - 播放指定录像；单人录像生成 1 个演员，多人录像同时生成多个演员。",color:"gray"}]
tellraw @s [{text:"/function replay:play/start_profile {name:\"Replay\",loop_playback:0b,on_finish_function:\"\",entity:{entity_type:\"minecraft:mannequin\",profile_name:\"PlayerName\",texture:\"rpg:masha\",custom_name:\"Replay\",custom_name_visible:1b,hide_description:1b}}",color:"green"},{text:" - 使用自定义演员实体数据播放。多人录像会把这个实体数据应用到所有演员。",color:"gray"}]
tellraw @s [{text:"/function replay:play/start_profile {name:\"Replay\",loop_playback:0b,on_finish_function:\"replay:event/my_finish\",entity:{entity_type:\"minecraft:zombie\",custom_name:\"Replay\",NoAI:1b}}",color:"green"},{text:" - 使用其他实体类型并设置结束回调。",color:"gray"}]
tellraw @s [{text:"start_profile 提示",color:"yellow"},{text:" - loop_playback 和 on_finish_function 是顶层播放选项；entity 里可放 profile_name、texture、model、elytra、cape、custom_name 等演员数据。",color:"gray"}]
tellraw @s [{text:"execute as <entity> at @s run function replay:play/start {name:\"Replay\"}",color:"aqua"},{text:" - 单人录像可让指定实体作为演员播放；多人录像当前总是召唤多个新演员。",color:"gray"}]
tellraw @s [{text:"回放控制",color:"yellow"}]
tellraw @s [{text:"/function replay:play/stop_nearest",color:"yellow"},{text:" - 停止最近的活动回放演员。",color:"gray"}]
tellraw @s [{text:"/function replay:play/stop_named {name:\"Replay\"}",color:"yellow"},{text:" - 按录像名停止一个活动演员。",color:"gray"}]
tellraw @s [{text:"/function replay:play/stop",color:"yellow"},{text:" - 停止全部回放，但保留演员实体。",color:"gray"}]
tellraw @s [{text:"/function replay:play/kill_actor",color:"red"},{text:" - 清除由回放生成的演员实体。",color:"gray"}]
tellraw @s [{text:"设置",color:"yellow"}]
tellraw @s [{text:"/function replay:settings/open",color:"green"},{text:" - 打开回放设置对话框。",color:"gray"}]
tellraw @s [{text:"/function replay:settings/show",color:"green"},{text:" - 显示当前回放设置。",color:"gray"}]
